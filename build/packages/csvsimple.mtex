% csvsimple: CSV files as tables.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{csvsimple}
\begin{filecontents*}{data.csv}
Name,Age
Ada,36
Alan,41
\end{filecontents*}
\begin{document}
\csvautotabular{data.csv} \csvreader[head to column names]{data.csv}{}{\Name\ is \Age. }
\end{document}
