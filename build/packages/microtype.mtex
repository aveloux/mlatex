% microtype: micro-typography.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage[protrusion=true,expansion=true]{microtype}
\begin{document}
\microtypesetup{protrusion=true, expansion=true}
\textls[200]{Letter-spaced} text and \lsstyle tracked words; \SetTracking{encoding=*}{50}.
\end{document}
