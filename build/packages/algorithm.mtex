% algorithm: the algorithm float.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{algorithm}
\usepackage{algpseudocode}
\begin{document}
\begin{algorithm}[htbp]
\caption{Euclid's algorithm}\label{alg:euclid}
\begin{algorithmic}[1]
\Procedure{Euclid}{$a,b$}
\While{$b\neq 0$}
\State $t \gets b$
\State $b \gets a \bmod b$
\State $a \gets t$
\EndWhile
\State \Return $a$
\EndProcedure
\end{algorithmic}
\end{algorithm}
Algorithm~\ref{alg:euclid} is Euclid's.
\end{document}
