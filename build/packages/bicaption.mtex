% bicaption: captions in two languages.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{bicaption}
\begin{document}
\begin{figure}[h]\centering\rule{1cm}{1cm}\bicaption{English}{Deutsch}\end{figure}
\end{document}
