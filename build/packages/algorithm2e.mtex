% algorithm2e: algorithms as their steps.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage[ruled,vlined,linesnumbered]{algorithm2e}
\begin{document}
\begin{algorithm}[H]
\SetAlgoLined
\KwData{a list $L$}
\KwResult{$L$ sorted}
\For{$i \leftarrow 1$ \KwTo $n$}{
  \If{$L_i > L_{i+1}$}{swap $L_i$ and $L_{i+1}$\;}
  \Else{continue\;}
}
\While{not sorted}{repeat\;}
\Return{$L$}\;
\caption{Bubble sort}
\end{algorithm}
\end{document}
