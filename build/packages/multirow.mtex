% multirow: a cell over rows.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{multirow}
\begin{document}
\begin{tabular}{|c|c|}\hline
\multirow{2}{*}{Two rows} & a \\
 & b \\\hline
\multirow[t]{2}{2cm}{Top} & c \\ & d \\\hline
\end{tabular}
\end{document}
