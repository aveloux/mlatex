% tabu: flexible tables.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{tabu}
\begin{document}
\begin{tabu} to \linewidth {X[l] X[c] X[r]}
\rowfont{\bfseries} Left & Centre & Right \\
a & b & c \\
\end{tabu}
\begin{longtabu}{X X}a & b\\\end{longtabu}
\end{document}
