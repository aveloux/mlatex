% changepage: width and page parity.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage[strict]{changepage}
\begin{document}
\begin{adjustwidth}{1cm}{1cm}Narrower text.\end{adjustwidth}\checkoddpage\ifoddpage odd\else even\fi
\end{document}
