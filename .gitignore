# Build trees: CLion's profiles' and the presets', all named cmake-build-*.
cmake-build-*/

# The sample documents in build/ are tracked; what they make is not, since
# main.pdf changes every day through \today.
/build/**/*.pdf

# Packages a release build leaves behind, in bin/.
/bin/
*.msi
*.dmg
*.deb
*.rpm

# What a release copies into the npm and Python packages before packing them:
# the built engine, its fonts and the license.
/bindings/javascript/latex.*
!/bindings/javascript/latex.d.ts
/bindings/javascript/LICENSE
/bindings/python/LICENSE
/bindings/python/mlatex/*.dll
/bindings/python/mlatex/*.so
/bindings/python/mlatex/*.dylib
/bindings/python/mlatex/assets/
