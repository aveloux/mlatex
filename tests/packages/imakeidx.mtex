% imakeidx: an index made in the run.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{imakeidx}
\makeindex[columns=2, title=Index]
\begin{document}
Aardvark\index{aardvark}, bear\index{bear|textbf}, cat\index{animal!cat}.
\printindex
\end{document}
