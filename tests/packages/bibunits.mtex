% bibunits: bibliographies by unit.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{bibunits}
\begin{document}
\begin{bibunit}
A unit cites \cite{a}.
\begin{thebibliography}{1}\bibitem{a} An entry.\end{thebibliography}
\end{bibunit}
\end{document}
