% newfloat: new float environments.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{newfloat}
\begin{document}
\DeclareFloatingEnvironment[fileext=los, name=Scheme]{scheme}
\begin{scheme}[htbp]\centering A scheme.\caption{The first scheme}\end{scheme}
\end{document}
