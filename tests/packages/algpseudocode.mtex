% algpseudocode: pseudocode, algorithmicx style.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{algpseudocode}
\begin{document}
\begin{algorithmic}[1]
\Require $x > 0$
\Function{Square}{$x$}
\State $y \gets x^2$ \Comment{square it}
\If{$y > 1$}
\State \Return $y$
\ElsIf{$y = 1$}
\State \Return $1$
\Else
\State \Return $0$
\EndIf
\EndFunction
\Repeat
\State step
\Until{done}
\Loop
\State forever
\EndLoop
\ForAll{$v \in V$}
\State visit $v$
\EndFor
\Statex
\State \Call{Square}{2}
\end{algorithmic}
\end{document}
