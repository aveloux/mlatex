% quotchap: chapters with quotations.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{report}
\usepackage{quotchap}
\begin{document}
\begin{savequote}[8cm]A quotation.\qauthor{Someone}\end{savequote}\chapter{Quoted}Text.
\end{document}
