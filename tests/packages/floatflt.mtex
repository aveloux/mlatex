% floatflt: figures text flows round.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{floatflt}
\begin{document}
\begin{floatingfigure}[r]{3cm}\rule{2cm}{2cm}\caption{Floating}\end{floatingfigure}Text beside it.
\end{document}
