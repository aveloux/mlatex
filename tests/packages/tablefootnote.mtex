% tablefootnote: footnotes in tables.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{tablefootnote}
\begin{document}
\begin{table}[h]\begin{tabular}{c}a\tablefootnote{A note.}\end{tabular}\end{table}
\end{document}
