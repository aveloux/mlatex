% lstautogobble: listings without their indentation.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{lstautogobble}
\usepackage{listings}
\begin{document}
\begin{lstlisting}[autogobble]
    indented code
\end{lstlisting}
\end{document}
