% multienum: several items to a line.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{multienum}
\begin{document}
\begin{multienumerate}
\mitemxx{one}{two}
\mitemxxx{three}{four}{five}
\end{multienumerate}
\end{document}
