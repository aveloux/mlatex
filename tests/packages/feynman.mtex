% feynman: Feynman diagrams in a picture.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{feynman}
\begin{document}
\setlength{\unitlength}{1pt}
\begin{picture}(100,50)
\put(0,0){\line(2,1){100}}
\put(0,50){\vector(1,0){100}}
\put(50,25){\circle*{4}}
\put(5,30){Diagram}
\end{picture}
\end{document}
