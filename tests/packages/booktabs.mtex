% booktabs: rules for tables.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage{booktabs}
\begin{document}
\begin{tabular}{lr}
\toprule
Item & Price \\
\midrule
Tea & 2 \\
\cmidrule(lr){1-2}
Cake & 3 \\
\addlinespace
Total & 5 \\
\bottomrule
\end{tabular}
\end{document}
