% caption: how captions are set.
% Set by tests/test_engine.cpp with every other document in this folder,
% which wants each to come out with no error and no unknown package.
\documentclass{article}
\usepackage[font=small,labelfont=bf]{caption}
\begin{document}
\captionsetup{font=small,labelfont=bf,labelsep=period}
\begin{figure}[htbp]
\centering
\rule{2cm}{1cm}
\caption[Short]{A long caption for a figure.}
\end{figure}
\captionof{table}{A caption outside a float.}
\end{document}
