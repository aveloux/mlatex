% fontawesome5: Font Awesome's icons, as a CV's contact line or a list's
% bullets use them. The engine carries no icon font, so each is the Unicode
% symbol nearest it, drawn from whatever face the system has that holds it
% -- an envelope, a telephone, a globe -- and a brand's logo, which Unicode
% has none of, a dot in its place. An icon's style, `\faEnvelope[regular]`,
% is read and let go. fontawesome, the fourth version, is read as this.
%
%   \faEnvelope\ ada@example.org   \faGithub\ github.com/ada

\@define\faEnvelope[1][]{✉}
\@define\faEnvelopeOpen[1][]{✉}
\@define\faEnvelopeO[1][]{✉}
