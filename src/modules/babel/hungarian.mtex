% Hungarian: babel's captions for it, and its date: 2026. szeptember 28.

\@define\captionshungarian{%
\@define\abstractname{Kivonat}%
\@define\proofname{Bizonyítás}%
\@define\figurename{Ábra}%
\@define\tablename{Táblázat}%
\@define\refname{Hivatkozások}%
\@define\bibname{Irodalomjegyzék}%
