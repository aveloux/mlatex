% French: babel's captions for it, and its date: 28 septembre 2026, and 1er for the first of a month.

\@define\captionsfrench{%
\@define\abstractname{Résumé}%
\@define\proofname{Démonstration}%
\@define\figurename{Figure}%
\@define\tablename{Table}%
\@define\refname{Références}%
