\@define\listtablename{Liste des tableaux}%
\@define\appendixname{Annexe}%
\@define\partname{Partie}%
\@define\chaptername{Chapitre}%
\@define\indexname{Index}}
\@define\datefrench{\@define\today{\ifnum\day=1 1\textsuperscript{er}\else\@evaluate{\day}\fi~\ifcase\month\or janvier \or février \or mars \or avril \or mai \or juin \or juillet \or août \or septembre \or octobre \or novembre \or décembre \fi\@evaluate{\year}}}
