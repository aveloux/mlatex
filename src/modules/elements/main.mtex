% elements: the chemical elements by their atomic numbers -- each one's
% symbol and its English name -- and an element's number by its symbol.
%
%   \elementsymbol{6} is \elementname{6}; carbon is \atomicnumber{C}.

\@define\elementsymbol[1]{\@nameuse{@elementsymbol\@evaluate{#1}}}
\@define\elementname[1]{\@nameuse{@elementname\@evaluate{#1}}}
\@define\Elementname[1]{\@nameuse{@Elementname\@evaluate{#1}}}
\@define\atomicnumber[1]{\@nameuse{@atomicnumber#1}}
\@define\@element#1#2#3#4{\@namedef{@elementsymbol#1}{#2}\@namedef{@elementname#1}{#3}\@namedef{@Elementname#1}{#4}\@namedef{@atomicnumber#2}{#1}}
