% pgfgantt: a Gantt chart -- a task to a row, each with its span of the
% chart's units -- set as a table of tasks and their spans.
%
%   \begin{ganttchart}{1}{6}
%     \gantttitle{Weeks}{6} \\
%     \ganttbar{Design}{1}{2} \\
%     \ganttmilestone{Ship}{6}
%   \end{ganttchart}

\@define\ganttchart[3][]{\begin{tabular}{ll}}
\@define\endganttchart{\end{tabular}}
\@define\gantttitle[3][]{\multicolumn{2}{c}{\textbf{#2}}}
\@define\gantttitlelist[3][]{\multicolumn{2}{c}{#2}}
\@define\gantttitlecalendar[3][]{}
\@define\ganttbar[4][]{#2 & #3--#4}
\@define\ganttgroup[4][]{\textbf{#2} & #3--#4}
\@define\ganttmilestone[3][]{#2 & #3}
\@define\ganttlink[3][]{}
\@define\ganttnewline[2][]{\\}
\@define\ganttset[1]{}
