% titleps: page styles of a document's own, their heads and feet set left,
% centre and right -- drawn as fancyhdr draws its own.
%
%   \newpagestyle{main}{\sethead{\thetitle}{}{\thepage}\headrule}
%   \pagestyle{main}

\@requirepackage{fancyhdr}

\@define\newpagestyle[2]{\@namedef{ps@#1}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}#2}}
\@alias\renewpagestyle\newpagestyle
\@define\sethead{\@ifstar{\@titlepshead}{\@titlepshead}}
\@define\@titlepshead[3]{\fancyhead[L]{#1}\fancyhead[C]{#2}\fancyhead[R]{#3}}
\@define\setfoot{\@ifstar{\@titlepsfoot}{\@titlepsfoot}}
\@define\@titlepsfoot[3]{\fancyfoot[L]{#1}\fancyfoot[C]{#2}\fancyfoot[R]{#3}}
\@define\headrule{\renewcommand{\headrulewidth}{0.4pt}}
\@define\footrule{\renewcommand{\footrulewidth}{0.4pt}}
\@define\setheadrule[1]{\renewcommand{\headrulewidth}{#1}}
\@define\setfootrule[1]{\renewcommand{\footrulewidth}{#1}}
\@define\settitlemarks{\@ifstar{\@gobble}{\@gobble}}
\@define\widenhead{\@ifstar{\@gobbletwo}{\@gobbletwo}}
\@define\setmarks[2]{}
