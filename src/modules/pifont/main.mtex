% pifont: Zapf Dingbats by number -- \ding{51} a check mark, \ding{172} a
% circled one -- set as the characters Unicode gives them. Most of the font's
% codes run in step with Unicode's Dingbats block, a range at a time; the
% few that Unicode placed elsewhere are listed by number.
%   \ding{51}  \ding{55}  \ding{72}  \Pisymbol{pzd}{43}

\@define\ding[1]{\@ifundefined{@ding#1}{\char\numexpr\@dingcode{#1}\relax}{\char\@nameuse{@ding#1}\relax}}
\@define\@dingcode[1]{%
  \ifnum#1<128 "2700+#1-32\else
  \ifnum#1<161 "2768+#1-128\else
  \ifnum#1<172 "2700+#1-64\else
  \ifnum#1<182 "2460+#1-172\else
  \ifnum#1<212 "2776+#1-182\else
  "2798+#1-216\fi\fi\fi\fi\fi}

\@namedef{@ding37}{"260E}
\@namedef{@ding42}{"261B}
\@namedef{@ding43}{"261E}
\@namedef{@ding72}{"2605}
\@namedef{@ding108}{"25CF}
\@namedef{@ding110}{"25A0}
\@namedef{@ding115}{"25B2}
\@namedef{@ding116}{"25BC}
\@namedef{@ding117}{"25C6}
\@namedef{@ding119}{"25D7}
\@namedef{@ding168}{"2663}
\@namedef{@ding169}{"2666}
\@namedef{@ding170}{"2665}
\@namedef{@ding171}{"2660}
\@namedef{@ding212}{"2794}
\@namedef{@ding213}{"2192}
\@namedef{@ding214}{"2194}
\@namedef{@ding215}{"2195}

% Any Pi font by its name and a number: Zapf Dingbats is the one carried.
\@define\Pisymbol[2]{\ding{#2}}
\@define\Piline[2]{\dingline{#2}}
\@define\Pifill[2]{\dingfill{#2}}

% A line of one dingbat, or the rest of one filled with it: here a line of
% three, centred, and a rule's worth of space.
\@define\dingline[1]{\par\centerline{\ding{#1}\quad\ding{#1}\quad\ding{#1}}\par}
\@define\dingfill[1]{\hfill}
