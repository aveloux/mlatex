% tkz-euclide: Euclidean geometry in TikZ -- points defined and named,
% segments, lines and circles between them, points drawn and labelled.

\@requirepackage{tikz}

\@define\tkzInit[1][]{}
\@define\tkzClip[1][]{}
\@define\tkzDefPoint{\@ifnextchar[{\@tkzpointoptions}{\@tkzpoint}}
\@define\@tkzpointoptions[#1]{\@tkzpoint}
\@define\@tkzpoint(#1)#2{\coordinate (#2) at (#1);}
\@define\tkzDefPoints[1]{}
\@define\tkzDrawSegment{\@ifnextchar[{\@tkzsegmentoptions}{\@tkzsegment}}
\@define\@tkzsegmentoptions[#1]{\@tkzsegment}
\@define\@tkzsegment(#1,#2){\draw (#1) -- (#2);}
\@define\tkzDrawLine{\@ifnextchar[{\@tkzsegmentoptions}{\@tkzsegment}}
\@define\tkzDrawPolygon{\@ifnextchar[{\@tkzpolygonoptions}{\@tkzpolygon}}
\@define\@tkzpolygonoptions[#1]{\@tkzpolygon}
\@define\@tkzpolygon(#1,#2,#3){\draw (#1) -- (#2) -- (#3) -- cycle;}
\@define\tkzDrawCircle{\@ifnextchar[{\@tkzcircleoptions}{\@tkzcircle}}
\@define\@tkzcircleoptions[#1]{\@tkzcircle}
\@define\@tkzcircle(#1,#2){\draw (#1) circle (1);}
\@define\tkzDrawPoint{\@ifnextchar[{\@tkzdotoptions}{\@tkzdot}}
\@define\@tkzdotoptions[#1]{\@tkzdot}
\@define\@tkzdot(#1){\fill (#1) circle (1.5pt);}
\@define\tkzDrawPoints{\@ifnextchar[{\@tkzdotoptions}{\@tkzdot}}
\@define\tkzLabelPoint{\@ifnextchar[{\@tkzlabeloptions}{\@tkzlabel}}
\@define\@tkzlabeloptions[#1]{\@tkzlabel}
\@define\@tkzlabel(#1)#2{\node[above right] at (#1) {#2};}
\@define\tkzLabelPoints{\@ifnextchar[{\@tkzlabelsoptions}{\@tkzlabels}}
\@define\@tkzlabelsoptions[#1]{\@tkzlabels}
\@define\@tkzlabels(#1){}
\@define\tkzMarkAngle{\@ifnextchar[{\@tkzangleoptions}{\@tkzangle}}
\@define\@tkzangleoptions[#1]{\@tkzangle}
\@define\@tkzangle(#1){}
\@define\tkzMarkRightAngle{\@ifnextchar[{\@tkzangleoptions}{\@tkzangle}}
\@define\tkzSetUpPoint[1][]{}
\@define\tkzSetUpLine[1][]{}
