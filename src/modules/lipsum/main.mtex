% lipsum: placeholder text, for a layout to be judged before its words exist.
%
%   \lipsum        % paragraphs 1 to 7, as the package's own default
%   \lipsum[2]     % the second alone
%   \lipsum[4-9]   % the fourth to the ninth
%
% The text is the printer's old Lorem ipsum, which has stood in for real
% words since type was set by hand: Latin enough to look like prose, and
% meaning nothing, so nobody reads it instead of looking at the page. There
% are five paragraphs of it here, and a number past the fifth comes round
% to the first again.

% The paragraph being set, in a register of the package's own.
\@name\lipsumat\integer242

\@define\lipsum[1][1-7]{\@lipsumrange#1--\@stop}
\@define\@lipsumrange#1-#2-#3\@stop{\@set\lipsumat=#1 \@repeat[\@evaluate{\@ifempty{#2}0\else#2-#1\fi+1}]{\lipsumparagraph{\@evaluate{(\lipsumat-1)\mod5+1}}\par\@increase\lipsumat by 1 }}

