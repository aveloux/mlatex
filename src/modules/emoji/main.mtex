% emoji: an emoji by its name, as the character it is, from whichever of the
% system's faces draws it. A name it does not know sets nothing.
%
%   \emoji{smile} \emoji{thumbs-up} \emoji{rocket}

\@define\emoji[1]{\@nameuse{@emoji#1}}
\@define\setemojifont[2][]{}
