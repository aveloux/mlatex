% beamer: slides. Each frame is a page of its own, 128 by 96 millimetres,
% its title in the structure's blue at its head and what it holds in the
% middle of the rest, set in eleven-point sans serif, ragged right, with
% the class's blue triangles for bullets:
%
%   \begin{frame}{Motivation}
%   \begin{itemize}
%   \item<1-> First point
%   \end{itemize}
%   \end{frame}
%
% The frame, its columns and its blocks are the engine's own. A frame is as
% many slides as its overlays ask for -- \pause, \only<2>, \item<2->,
% \begin{itemize}[<+->] -- each a page, what a slide does not show unseen in
% its place; its theme draws its head, its foot and its frame titles.

\@requirepackage{amsmath}
\@requirepackage{amssymb}
\@requirepackage{amsthm}
\@requirepackage{hyperref}

\pagewidth=128mm \pageheight=96mm
\@leftmargin=1cm \@rightmargin=1cm \@topmargin=0.35cm \@bottommargin=0.6cm
\setlength{\parindent}{0pt}
\renewcommand{\familydefault}{\sfdefault}
\@define\@bodyshape{\raggedright}
\raggedright
\pagestyle{empty}

% The default theme's colors: the structure's blue, an alert's red, and an
% example's green.
\definecolor{structure}{rgb}{0.2,0.2,0.7}
\definecolor{alerted}{rgb}{1,0,0}
\definecolor{example}{rgb}{0,0.5,0}

% The title, subtitle, authors, institute and date, each with the short form
% a theme's foot carries -- the long one when none is given.
\@define\@subtitle{}
\@define\@institute{}
\@define\thetitle{}
\@define\theauthor{}
\@define\thedate{\today}
\@define\@shorttitle{}
\@define\@shortauthor{}
\@define\@shortdate{}
\@define\title[2][]{\@define\thetitle{#2}\@define\@shorttitle{#1}}
\@define\subtitle[2][]{\@define\@subtitle{\par\vskip .3em{\normalsize #2\par}}}
\@define\author[2][]{\@define\theauthor{#2}\@define\@shortauthor{#1}}
\@define\date[2][]{\@define\thedate{#2}\@define\@shortdate{#1}}
\@define\institute[2][]{\@define\@institute{#2}}
\@define\insertshorttitle{\expandafter\@ifempty\expandafter{\@shorttitle}\thetitle\else\@shorttitle\fi}
\@define\insertshortauthor{\expandafter\@ifempty\expandafter{\@shortauthor}\theauthor\else\@shortauthor\fi}
\@define\insertshortdate{\expandafter\@ifempty\expandafter{\@shortdate}\thedate\else\@shortdate\fi}
\@define\titlegraphic[1]{}
\@define\logo[1]{}
\@define\inserttitle{\thetitle}
\@define\insertauthor{\theauthor}
\@define\insertdate{\thedate}
\@define\insertinstitute{\@institute}
\@define\insertframenumber{\thepage}

\@define\titlepage{%
\begin{center}%
{\color{structure}{\Large\thetitle\par}\@subtitle}%
\vskip 1.5em%
{\small\theauthor\par}%
\vskip .5em%
{\scriptsize\@institute\par}%
\vskip .5em%
{\small\thedate\par}%
\end{center}}
\@define\maketitle{\titlepage}

% A frame by its command, `\frame{\titlepage}`, and a frame's title and
% subtitle wherever they are written.
\@define\frame{\@ifnextchar<{\@frameoverlay}{\@framed}}
\@define\@frameoverlay<#1>{\@framed}
\@define\@framed[2][]{\begin{frame}[#1]#2\end{frame}}
\@define\frametitle{\@ifnextchar<{\@titleoverlay}{\@frametitle}}
\@define\@titleoverlay<#1>{\@frametitle}
\@define\@frametitle[2][]{{\Large\color{structure}#2\par}\vskip .2em}
\@define\framesubtitle[2][]{{\small\color{structure}#2\par}\vskip .2em}

% Sections make no heading: each is a line of the contents, and whatever
% \AtBeginSection asked for -- an outline frame, as a rule.
\@define\@sectionhook{}
\@define\@subsectionhook{}
\@define\AtBeginSection[2][]{\@define\@sectionhook{#2}}
\@define\AtBeginSubsection[2][]{\@define\@subsectionhook{#2}}
\@define\insertsectionhead{}
\@define\insertsubsectionhead{}
\@define\section{\@ifstar{\@gobble}{\@beamersection}}
\@define\@beamersection[2][]{\refstepcounter{section}\@define\insertsectionhead{#2}\@define\insertsubsectionhead{}%
\markboth{\@marked{#2}}{}\addcontentsline{toc}{section}{#2}\@sectionhook}
\@define\subsection{\@ifstar{\@gobble}{\@beamersubsection}}
\@define\@beamersubsection[2][]{\refstepcounter{subsection}\@define\insertsubsectionhead{#2}%
\markright{\@marked{#2}}\addcontentsline{toc}{subsection}{#2}\@subsectionhook}
% A section's name as a theme's head shows it, set as its band's text is.
\@define\@marked[1]{\color{white}\tiny #1}

% The contents are an outline: no heading, no pages, and a section's
% options -- `[currentsection]` -- read and let go.
\@setvariable{contents.bare}{true}
\let\@contents\tableofcontents
\@define\tableofcontents[1][]{\@contents}

% Bullets are the structure's triangles, smaller a level down.
\@define\labelitemi{\textcolor{structure}{\scriptsize$\blacktriangleright$}}
\@define\labelitemii{\textcolor{structure}{\tiny$\blacktriangleright$}}
\@define\labelitemiii{\textcolor{structure}{\tiny$\blacktriangleright$}}

% The theorems beamer declares, unnumbered, as its default theme sets them.
\theoremstyle{plain}
\newtheorem*{theorem}{Theorem}
\newtheorem*{corollary}{Corollary}
\newtheorem*{fact}{Fact}
\newtheorem*{lemma}{Lemma}
\theoremstyle{definition}
\newtheorem*{definition}{Definition}
\newtheorem*{definitions}{Definitions}
\newtheorem*{example}{Example}
\newtheorem*{examples}{Examples}
\theoremstyle{plain}

% Emphasis in the alert's red, and in the structure's blue -- on the slides
% an overlay names, as written on the others.
\@define\alert{\@ifnextchar<{\@alertoverlay}{\@alerted}}
\@define\@alertoverlay<#1>#2{\@onslide{#1}{\@alerted{#2}}{#2}}
\@define\@alerted[1]{\textcolor{alerted}{#1}}
\@define\structure{\@ifnextchar<{\@structureoverlay}{\@structured}}
\@define\@structureoverlay<#1>#2{\@onslide{#1}{\@structured{#2}}{#2}}
\@define\@structured[1]{\textcolor{structure}{#1}}
\let\@beamertextbf\textbf
\let\@beamertextit\textit
\let\@beameremph\emph
\let\@beamercolor\color
\let\@beamertextcolor\textcolor
\@define\textbf{\@ifnextchar<{\@textbfoverlay}{\@beamertextbf}}
\@define\@textbfoverlay<#1>#2{\@onslide{#1}{\@beamertextbf{#2}}{#2}}
\@define\textit{\@ifnextchar<{\@textitoverlay}{\@beamertextit}}
\@define\@textitoverlay<#1>#2{\@onslide{#1}{\@beamertextit{#2}}{#2}}
\@define\emph{\@ifnextchar<{\@emphoverlay}{\@beameremph}}
\@define\@emphoverlay<#1>#2{\@onslide{#1}{\@beameremph{#2}}{#2}}
\@define\color{\@ifnextchar<{\@coloroverlay}{\@beamercolor}}
\@define\@coloroverlay<#1>#2{\@onslide{#1}{\@beamercolor{#2}}{}}
\@define\textcolor{\@ifnextchar<{\@textcoloroverlay}{\@beamertextcolor}}
\@define\@textcoloroverlay<#1>#2#3{\@onslide{#1}{\@beamertextcolor{#2}{#3}}{#3}}

% Overlays: the engine counts a frame's slides and reads it once for each;
% \@onslide{overlay}{shown}{hidden} chooses what one shows. \only's text is
% there on its slides alone; \uncover's and \visible's are in their place on
% every slide and seen on theirs, \invisible's the other way round; \onslide
% with no text sets what follows it; \alt is its first text on its slides
% and its second on the rest; an item with an overlay is unseen, its label
% too, until its slides.
\@define\pause{\@pause}
\@define\only{\@ifnextchar<{\@onlyoverlay}{\@onlyplain}}
\@define\@onlyoverlay<#1>#2{\@onslide{#1}{#2}{}}
\@define\@onlyplain[1]{\@ifnextchar<{\@onlyafter{#1}}{#1}}
\@define\@onlyafter#1<#2>{\@onslide{#2}{#1}{}}
\@define\uncover{\@ifnextchar<{\@uncoveroverlay}{}}
\@define\@uncoveroverlay<#1>#2{\@onslide{#1}{#2}{{\@conceal#2}}}
\@define\visible{\@ifnextchar<{\@uncoveroverlay}{}}
\@define\invisible{\@ifnextchar<{\@invisibleoverlay}{}}
\@define\@invisibleoverlay<#1>#2{\@onslide{#1}{{\@conceal#2}}{#2}}
\@define\onslide{\@ifnextchar<{\@onslideoverlay}{\@reveal}}
\@define\@onslideoverlay<#1>{\@ifnextchar\bgroup{\@uncoveroverlay<#1>}{\@onslide{#1}{\@reveal}{\@conceal}}}
\@define\alt{\@ifnextchar<{\@altoverlay}{\@altplain}}
\@define\@altoverlay<#1>#2#3{\@onslide{#1}{#2}{#3}}
\@define\@altplain[2]{\@ifnextchar<{\@altafter{#1}{#2}}{#1}}
\@define\@altafter#1#2<#3>{\@onslide{#3}{#1}{#2}}
\@define\temporal<#1>#2#3#4{\@onslide{#1}{#3}{#2}}
\let\@beameritem\item
\@define\item{\@ifnextchar<{\@itemoverlay}{\@reveal\@beameritem}}
\@define\@itemoverlay<#1>{\@onslide{#1}{\@reveal}{\@conceal}\@beameritem}
\@define\mode<#1>{}
\@define\note[2][]{}
\@define\beamerdefaultoverlayspecification[1]{}

% Themes, as beamer draws its own: each a colour theme's colours, an outer
% theme's head and foot -- infolines' three boxes of author, title, date and
% page, split's two, a band of the section above -- a frame title on a band
% or plain, and an inner theme's bullets. The palette's three blues, dark
% to light, are what the boxes are painted in.
\colorlet{tertiary}{structure!70!black}
\colorlet{secondary}{structure}
\colorlet{primary}{structure!55!white}
\@define\@palette{\colorlet{tertiary}{structure!70!black}\colorlet{secondary}{structure}%
\colorlet{primary}{structure!55!white}}

% A band of a line of tiny text across a share of the paper, in a colour.
\@define\@band#1#2#3#4#5{\colorbox{#1}{\makebox[#2\paperwidth][#3]{\rule[-3pt]{0pt}{9pt}\hspace{.5em}\color{#4}\tiny #5\hspace{.5em}}}}

% The outer themes' heads and feet, at the slide's very edges, no rules
% under or over them: set as the document begins, when its title and its
% authors are known, the section's and the subsection's names the marks
% each \section and \subsection sets.
\@define\@foot#1{\pagestyle{fancy}\pagerules{0pt}{0pt}\setlength{\footskip}{\dimexpr 0.6cm-3pt\relax}%
\AtBeginDocument{\fancyfoot[L]{\hspace*{-1cm}{\setlength{\fboxsep}{0pt}#1}}}}
\@define\@head#1{\pagestyle{fancy}\pagerules{0pt}{0pt}\setlength{\headsep}{\dimexpr 0.35cm-6pt\relax}%
\@topmargin=0.65cm\AtBeginDocument{\fancyhead[L]{\hspace*{-1cm}{\setlength{\fboxsep}{0pt}#1}}}}
\@namedef{@outer@default}{}
\@namedef{@outer@infolines}{%
\@head{\@band{tertiary}{0.5}{l}{white}{\leftmark}\@band{secondary}{0.5}{l}{white}{\rightmark}}%
\@foot{\@band{tertiary}{0.3333}{c}{white}{\insertshortauthor}\@band{secondary}{0.3333}{c}{white}{\insertshorttitle}%
\@band{primary}{0.3334}{r}{black}{\insertshortdate\hspace{2em}\thepage}}}
\@namedef{@outer@split}{%
\@head{\@band{tertiary}{0.5}{l}{white}{\leftmark}\@band{secondary}{0.5}{l}{white}{\rightmark}}%
\@foot{\@band{tertiary}{0.5}{r}{white}{\insertshortauthor}\@band{secondary}{0.5}{l}{white}{\insertshorttitle}}}
\@namedef{@outer@smoothbars}{%
\@head{\@band{tertiary}{1}{l}{white}{\leftmark}}%
\@foot{\@band{tertiary}{0.5}{r}{white}{\insertshortauthor}\@band{secondary}{0.5}{l}{white}{\insertshorttitle}}}
\@namedef{@outer@miniframes}{\@head{\@band{tertiary}{1}{l}{white}{\leftmark}}}
\@namedef{@outer@shadow}{\@nameuse{@outer@split}}
\@namedef{@outer@tree}{\@head{\@band{secondary}{1}{l}{white}{\insertshorttitle\quad\leftmark}}}
\@namedef{@outer@sidebar}{}
\@namedef{@outer@metropolis}{\@foot{\@band{white}{1}{r}{structure}{\thepage}}}
\@define\useoutertheme[2][]{\@ifundefined{@outer@#2}{\warning{beamer: outer theme '#2' is drawn as the default}}%
{\@nameuse{@outer@#2}}}

% A frame title plain, in the structure's colour; on a band across the
% slide, white; or on one as wide as the text.
\@define\@titleplain[2][]{{\Large\color{structure}#2\par}\vskip .2em}
\@define\@titleband[2][]{\par\noindent\hspace*{-1cm}{\setlength{\fboxsep}{0pt}\colorbox{secondary}{\makebox[\paperwidth][l]%
{\rule[-.45em]{0pt}{1.6em}\hspace{1cm}\Large\color{white}#2}}}\par\vskip .4em}
\@define\@titlebox[2][]{\par\noindent{\setlength{\fboxsep}{0pt}\colorbox{primary}{\makebox[\textwidth][l]%
{\rule[-.45em]{0pt}{1.6em}\hspace{.4em}\Large\color{tertiary}#2}}}\par\vskip .4em}
\@define\@titles#1{\expandafter\let\expandafter\@frametitle\csname @title#1\endcsname}

% The inner themes' bullets: triangles, balls, circles, squares.
\@define\@bullets#1#2{\@define\labelitemi{\textcolor{structure}{#1}}\@define\labelitemii{\textcolor{structure}{#2}}%
\@define\labelitemiii{\textcolor{structure}{#2}}}
\@namedef{@inner@default}{}
\@namedef{@inner@rounded}{\@bullets{\small$\bullet$}{\scriptsize$\bullet$}}
\@namedef{@inner@circles}{\@bullets{\small$\bullet$}{\scriptsize$\circ$}}
\@namedef{@inner@rectangles}{\@bullets{\rule[.2ex]{.45em}{.45em}}{\rule[.25ex]{.35em}{.35em}}}
\@define\useinnertheme[2][]{\@ifundefined{@inner@#2}{\warning{beamer: inner theme '#2' is drawn as the default}}%
{\@nameuse{@inner@#2}}}

% The colour themes: the structure's colour, and the palette made of it.
\@define\@hue#1{\definecolor{structure}{rgb}{#1}\@palette}
\@namedef{@colors@default}{\@hue{0.2,0.2,0.7}}
\@namedef{@colors@whale}{\@hue{0.2,0.2,0.7}}
\@namedef{@colors@dolphin}{\@hue{0.25,0.25,0.75}}
\@namedef{@colors@seahorse}{\@hue{0.4,0.4,0.8}}
\@namedef{@colors@beaver}{\@hue{0.67,0,0}}
\@namedef{@colors@crane}{\@hue{0.9,0.55,0}}
\@namedef{@colors@wolverine}{\@hue{0.1,0.2,0.45}\colorlet{primary}{yellow!80!orange}}
\@namedef{@colors@spruce}{\@hue{0,0.35,0.2}}
\@namedef{@colors@dove}{\@hue{0.3,0.3,0.3}}
\@namedef{@colors@seagull}{\@hue{0.45,0.45,0.45}}
\@namedef{@colors@fly}{\@hue{0.4,0.4,0.4}}
\@namedef{@colors@beetle}{\@hue{0.2,0.2,0.7}}
\@namedef{@colors@albatross}{\@hue{0.2,0.2,0.7}}
\@namedef{@colors@structure}{\@hue{0.2,0.2,0.7}}
\@namedef{@colors@metropolis}{\@hue{0.14,0.25,0.28}\colorlet{secondary}{structure}}
\@namedef{@colors@orchid}{}
\@namedef{@colors@rose}{}
\@namedef{@colors@lily}{}
\@define\usecolortheme[2][]{\@ifundefined{@colors@#2}{\warning{beamer: colour theme '#2' is drawn as the default}}%
{\@nameuse{@colors@#2}}}
\@define\usefonttheme[2][]{}

% The presentation themes: an outer theme, a frame title, bullets and
% colours each, as beamer's own combine them.
\@define\@theme#1#2#3#4{\@nameuse{@outer@#1}\@titles{#2}\@nameuse{@inner@#3}\@nameuse{@colors@#4}}
\@namedef{@theme@default}{}
\@namedef{@theme@AnnArbor}{\@theme{infolines}{band}{rounded}{wolverine}}
\@namedef{@theme@Antibes}{\@theme{tree}{band}{rounded}{whale}}
\@namedef{@theme@Bergen}{\@theme{sidebar}{plain}{rectangles}{default}}
\@namedef{@theme@Berkeley}{\@theme{sidebar}{band}{rounded}{whale}}
\@namedef{@theme@Berlin}{\@theme{smoothbars}{band}{rounded}{whale}}
\@namedef{@theme@Boadilla}{\@theme{infolines}{plain}{rounded}{dolphin}}
\@namedef{@theme@CambridgeUS}{\@theme{infolines}{band}{rounded}{beaver}}
\@namedef{@theme@Copenhagen}{\@theme{split}{band}{rounded}{whale}}
\@namedef{@theme@Darmstadt}{\@theme{smoothbars}{band}{rounded}{whale}}
\@namedef{@theme@Dresden}{\@theme{miniframes}{plain}{circles}{default}}
\@namedef{@theme@Frankfurt}{\@theme{smoothbars}{plain}{rounded}{default}}
\@namedef{@theme@Goettingen}{\@theme{sidebar}{plain}{rounded}{default}}
\@namedef{@theme@Hannover}{\@theme{sidebar}{plain}{rounded}{default}}
\@namedef{@theme@Ilmenau}{\@theme{smoothbars}{band}{rounded}{whale}}
\@namedef{@theme@JuanLesPins}{\@theme{tree}{band}{rounded}{whale}}
\@namedef{@theme@Luebeck}{\@theme{split}{band}{rounded}{whale}}
\@namedef{@theme@Madrid}{\@theme{infolines}{band}{rounded}{whale}}
\@namedef{@theme@Malmoe}{\@theme{split}{band}{rounded}{whale}}
\@namedef{@theme@Marburg}{\@theme{sidebar}{band}{rounded}{whale}}
\@namedef{@theme@Montpellier}{\@theme{tree}{plain}{rounded}{default}}
\@namedef{@theme@PaloAlto}{\@theme{sidebar}{band}{rounded}{whale}}
\@namedef{@theme@Pittsburgh}{\@theme{default}{plain}{default}{default}}
\@namedef{@theme@Rochester}{\@theme{default}{band}{rectangles}{whale}}
\@namedef{@theme@Singapore}{\@theme{miniframes}{plain}{circles}{default}}
\@namedef{@theme@Szeged}{\@theme{miniframes}{plain}{default}{default}}
\@namedef{@theme@Warsaw}{\@theme{shadow}{band}{rounded}{whale}}
\@namedef{@theme@metropolis}{\@theme{metropolis}{band}{rectangles}{metropolis}}
\@define\usetheme[2][]{\@ifundefined{@theme@#2}{\warning{beamer: theme '#2' is drawn as the default}}{\@nameuse{@theme@#2}}}
\@define\setbeamercolor{\@ifstar{\@gobbletwo}{\@gobbletwo}}
\@define\setbeamerfont{\@ifstar{\@gobbletwo}{\@gobbletwo}}
\@define\setbeamersize[1]{}
\@define\setbeamercovered[1]{}
\@define\setbeamertemplate[1]{\@templateoptions}
\@define\@templateoptions{\@ifnextchar[{\@templateoption}{\@ifnextchar\bgroup{\@gobble}{}}}
\@define\@templateoption[#1]{\@templateoptions}
\@define\usebeamercolor[2][]{}
\@define\usebeamerfont{\@ifstar{\@gobble}{\@gobble}}
\@define\usebeamertemplate{\@ifstar{\@gobble}{\@gobble}}
\@define\beamertemplatenavigationsymbolsempty{}
