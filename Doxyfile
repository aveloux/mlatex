PROJECT_NAME           = "Typesetting Engine"
PROJECT_BRIEF          = "Lexer, expander, parser and layout pipeline"
OUTPUT_DIRECTORY       = docs
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html

INPUT                  = include src
FILE_PATTERNS          = *.hpp *.cpp
RECURSIVE              = YES
EXCLUDE                = stubs tests

# Everything is documented with /// and ///<, so ordinary // comments stay out
# of the generated pages.
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# @complexity is not a built-in command; this registers it so the generated
# pages get a "Complexity" section wherever it appears.
ALIASES                = "complexity=@par Complexity:\n"

SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

GENERATE_TREEVIEW      = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include

BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO

HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES

# The stub headers are only there so the syntax subsystem builds on its own.
INCLUDE_PATH           = include
