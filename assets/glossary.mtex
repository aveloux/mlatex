% ---------------------------------------------------------------------------
% Numbers and dates: an ordinal's ending worked out from its last two
% digits -- 1st, 12th, 23rd -- and a number printed as it is written.

\nth[1]{#1\textsuperscript{\@ordinal{#1}}}
\@ordinal[1]{\ifnum\numexpr(#1-5)/10-10*((#1-50)/100)\relax=1 th\else\ifcase\numexpr#1-10*((#1-5)/10)\relax th\or st\or nd\or rd\else th\fi\fi}
\ordinalnum[1]{\nth{#1}}
\ordinal[1]{\nth{\arabic{#1}}}
