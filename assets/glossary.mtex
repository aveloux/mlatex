% options; a block's count, default and two bodies.

\@gobbleoptionone[2][]{}
\@gobbleoptiontwo[3][]{}
\@gobbleoptionthree[4][]{}
\@gobblefont[2][]{\@gobbleoption}
\@gobbleblock[1][]{\@gobbleoptiontwo}
