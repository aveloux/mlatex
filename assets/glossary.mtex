\reversemarginpar{}
\normalmarginpar{}
\hyphenation[1]{}
\discretionary[3]{#3}
\vcenter[1]{#1}
\raise#1\hbox#2{\raisebox{#1}{#2}}
\lower#1\hbox#2{\raisebox{-#1}{#2}}
\lettrine[3][]{{\LARGE #2}\textsc{#3}}

% ---------------------------------------------------------------------------
% etoolbox's hooks and its command tools. A command here is compiled and a
% block native, so patching either is let go.

\patchcmd[5]{}
\apptocmd[4]{}
\pretocmd[4]{}
\AtBeginEnvironment[2]{}
\AtEndEnvironment[2]{}
\BeforeBeginEnvironment[2]{}
\AfterEndEnvironment[2]{}
\AtEndPreamble[1]{\AtBeginDocument{#1}}
\AfterEndPreamble[1]{\AtBeginDocument{#1}}
\AfterEndDocument[1]{}
\newrobustcmd{\newcommand}
\renewrobustcmd{\renewcommand}
\providerobustcmd{\providecommand}
\csdef[1]{\@namedef{#1}}
\csgdef[1]{\@shared\@namedef{#1}}
\csedef[1]{\expandafter\edef\csname #1\endcsname}
\csxdef[1]{\expandafter\xdef\csname #1\endcsname}
\csuse[1]{\ifcsname #1\endcsname\csname #1\endcsname\fi}
\cslet[2]{\expandafter\let\csname #1\endcsname#2}
\letcs[2]{\expandafter\let\expandafter#1\csname #2\endcsname}
\csletcs[2]{\expandafter\let\csname #1\expandafter\endcsname\csname #2\endcsname}
\appto[2]{\edef#1{\ifdefined#1\unexpanded\expandafter{#1}\fi\unexpanded{#2}}}
\gappto[2]{\xdef#1{\ifdefined#1\unexpanded\expandafter{#1}\fi\unexpanded{#2}}}
\preto[2]{\edef#1{\unexpanded{#2}\ifdefined#1\unexpanded\expandafter{#1}\fi}}
\gpreto[2]{\xdef#1{\unexpanded{#2}\ifdefined#1\unexpanded\expandafter{#1}\fi}}
\eappto[2]{\edef#1{\ifdefined#1\unexpanded\expandafter{#1}\fi#2}}
\xappto[2]{\xdef#1{\ifdefined#1\unexpanded\expandafter{#1}\fi#2}}
\ifstrempty[1]{\@ifstrequal{#1}{}}
\ifdefempty[1]{\ifx#1\@empty\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\ifcsdef[1]{\ifcsname #1\endcsname\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\ifcsundef[1]{\ifcsname #1\endcsname\expandafter\@secondoftwo\else\expandafter\@firstoftwo\fi}
\ifdefmacro[1]{\ifdefined#1\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\ifdefstring[2]{\expandafter\@ifstrequal\expandafter{#1}{#2}}
\ifcsstring[2]{\expandafter\ifdefstring\csname #1\endcsname{#2}}

% ---------------------------------------------------------------------------
% Definitions a document may carry of blocks and fonts. A block is the
