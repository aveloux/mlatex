\cleartooddpage[1][]{\cleardoublepage}
\nowidow[1][2]{}
\noclub[1][2]{}
\balance{}
\nobalance{}
\flushend{}
\raggedend{}
\fnbelowfloat{}

% ---------------------------------------------------------------------------
% What packages tell LaTeX about themselves and each other -- warnings
% silenced, commands copied and patched, options declared -- read and let
% go, a copy made as \let makes one.

\WarningFilter[3][]{}
\WarningsOff{\@ifstar{\@gobbleoption}{\@gobbleoption}}
\ErrorFilter[3][]{}
\LetLtxMacro[2]{\let#1#2}
\xpatchcmd[5]{}
\xapptocmd[4]{}
\xpretocmd[4]{}
\regexpatchcmd[5]{}
\define@key[2]{\@gobbleoptionone}
\DeclareStringOption[2][]{\@gobbleoption}
\DeclareBoolOption[2][]{}
\DeclareVoidOption[2]{}
\DeclareDefaultOption[1]{}
\ProcessKeyvalOptions{\@ifstar{}{\@gobble}}
\SetupKeyvalOptions[1]{}
\NewEnviron[1]{\warning{NewEnviron #1: blocks are the engine's own, so this one is set as a plain group}\@environ}
\RenewEnviron[1]{\warning{RenewEnviron #1: blocks are the engine's own, and this one is set as the engine sets it}\@environ}
\@environ[1][]{\@environbody}
\@environbody[2][]{\@gobbleoption}
\AtBeginShipout[1]{}
\AtBeginShipoutNext[1]{}
\AtBeginShipoutFirst[1]{}
\AtBeginShipoutDiscard{}
\AtVeryEndDocument[1]{}
\AfterLastShipout[1]{}
\AtEndAfterFileList[1]{}
\EveryShipout[1]{}
\AtNextShipout[1]{}
\CatchFileDef[3]{\@define#1{}}
\ShellEscape[1]{}
\directlua[1]{}
\luaexec[1]{}
\luadirect[1]{}
\CJKfamily[1]{}
\ctexset[1]{}
\BeginAccSupp[1]{}
\EndAccSupp[1]{}

% ---------------------------------------------------------------------------
% Bibliographies by other packages' commands: an entry cited in full where
% bibentry sets it, a second list's commands let go, and the diagonal cell
% and the chemical structure written out as their text.

\bibentry[1]{\cite{#1}}
\nobibliography[1]{}
\newcites[2]{}
\backslashbox[3][]{\diagbox{#2}{#3}}
\chemfig[1]{\texttt{#1}}
\NiceMatrixOptions[1]{}
\SetTblrInner[1]{}
\SetTblrOuter[1]{}
\UseTblrLibrary[1]{}

% ---------------------------------------------------------------------------
% What the lines above read and let go with, each ending in the one command
% that reads on: an option and so many arguments; a font's name between two
% options; a block's count, default and two bodies.

\@gobbleoptionone[2][]{}
\@gobbleoptiontwo[3][]{}
\@gobbleoptionthree[4][]{}
\@gobblefont[2][]{\@gobbleoption}
\@gobbleblock[1][]{\@gobbleoptiontwo}
