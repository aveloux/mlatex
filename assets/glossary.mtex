% The glossary: what CTAN's packages define, for the commands no package of
% the engine's own gives a meaning. Each line is one command as \@define
% takes it -- its name, how many arguments, a default for the first, and a
% body -- and nothing is read until a document uses the command: the first
% time a name is met with no meaning, its line is read as
%   \@shared\@spanning\@define\name[n][default]{body}
% -- for the rest of the run, and taking a paragraph in an argument, as
% \newcommand's commands do -- and the name is read again. A document that
% never writes one pays nothing, and one that does pays a single lookup and
% a line.
%
% A body either keeps what the command was for -- \contour{white}{word} is
% the word, \textls{letters} the letters -- or lets it go, when the command
% only tunes what the engine decides itself: fonts, line breaking, kerning,
% page geometry after the preamble. A line is a line; a % starts a comment.

% ---------------------------------------------------------------------------
% microtype: the line breaker weighs each paragraph whole already; tracking
% and protrusion settings are read and let go, letter-spaced text kept.

\microtypesetup[1]{}
\microtypecontext[1]{}
\textls[2][]{#2}
\lsstyle{}
\SetTracking[3][]{}
\SetExtraKerning[3][]{}
\SetProtrusion[3][]{}
\SetExpansion[3][]{}
\DisableLigatures[2][]{}
\DeclareMicrotypeSet{\@ifstar{\@gobbleoptiontwo}{\@gobbleoptiontwo}}
\UseMicrotypeSet[2][]{}
\DeclareMicrotypeSetDefault[2][]{}
\DeclareMicrotypeAlias[2]{}
\DeclareMicrotypeBabelHook[2]{}
\DeclareCharacterInheritance[3][]{}
\LoadMicrotypeFile[1]{}

% ---------------------------------------------------------------------------
% geometry after the preamble: one page set on other margins, then the old
% ones back. The page keeps the preamble's margins throughout.

\newgeometry[1]{}
\restoregeometry{}
\savegeometry[1]{}
\loadgeometry[1]{}

% ---------------------------------------------------------------------------
% hyperref and friends: what a link is kept; the PDF's bookkeeping let go.

\subpdfbookmark[2]{}
\hyperbaseurl[1]{}
\hyperdef[3]{#3}
\pdfstringdefDisableCommands[1]{}
\urlstyle[1]{}
\urldef[2]{\@define#1{#2}}
\doi[1]{doi:#1}
\orcid[1]{\usepackage{orcidlink}\orcidlink{#1}}
\ORCID[1]{\usepackage{orcidlink}\orcidlink{#1}}

% ---------------------------------------------------------------------------
% cleveref's formats, which its names already give; its other references
% as the nearest the engine writes.

\crefformat[2]{}
\Crefformat[2]{}
\crefrangeformat[2]{}
\Crefrangeformat[2]{}
\crefmultiformat[5]{}
\Crefmultiformat[5]{}
\crefrangemultiformat[5]{}
\Crefrangemultiformat[5]{}
\crefalias[2]{}
\labelcref[1]{\ref{#1}}
\namecref[1]{\cref{#1}}
\nameCref[1]{\Cref{#1}}
\lcnamecref[1]{\cref{#1}}
\crefrange[2]{\cref{#1} to~\ref{#2}}
\Crefrange[2]{\Cref{#1} to~\ref{#2}}
\cpageref[1]{page~\pageref{#1}}
\Cpageref[1]{Page~\pageref{#1}}
\cpagerefrange[2]{pages~\pageref{#1} to~\pageref{#2}}
\Cpagerefrange[2]{Pages~\pageref{#1} to~\pageref{#2}}

% ---------------------------------------------------------------------------
% amsmath and mathtools: the rest of their commands, each as the nearest
% thing the formula setter draws.

\cfrac[3][c]{\dfrac{#2}{#3}}
\genfrac[6]{\frac{#5}{#6}}
\sideset[3]{{}#1#3#2}
\lefteqn[1]{#1}
\shortintertext[1]{\intertext{#1}}
\boxed[1]{#1}
\Aboxed[1]{#1}
\mathclap[1]{#1}
\mathllap[1]{#1}
\mathrlap[1]{#1}
\mathmakebox[1][]{\@gobbleoption}
\cramped[2][]{#2}
\smashoperator[2][]{#2}
\adjustlimits{}
\prescript[3]{{}^{#1}_{#2}#3}
\splitfrac[2]{#1#2}
\splitdfrac[2]{#1#2}
\shoveleft[1]{#1}
\shoveright[1]{#1}
\MoveEqLeft{\@gobbleoption}
\mathtoolsset[1]{}
\usetagform[1]{}
\newtagform[1]{\@gobbleoptiontwo}
\allowdisplaybreaks{\@gobbleoption}
\displaybreak{\@gobbleoption}
\xrightarrow[2][]{\underset{#1}{\overset{#2}{\longrightarrow}}}
\xleftarrow[2][]{\underset{#1}{\overset{#2}{\longleftarrow}}}
\xRightarrow[2][]{\underset{#1}{\overset{#2}{\Longrightarrow}}}
\xLeftarrow[2][]{\underset{#1}{\overset{#2}{\Longleftarrow}}}
\xleftrightarrow[2][]{\underset{#1}{\overset{#2}{\longleftrightarrow}}}
\xLeftrightarrow[2][]{\underset{#1}{\overset{#2}{\Longleftrightarrow}}}
\xmapsto[2][]{\underset{#1}{\overset{#2}{\longmapsto}}}
\xhookrightarrow[2][]{\underset{#1}{\overset{#2}{\hookrightarrow}}}
\xhookleftarrow[2][]{\underset{#1}{\overset{#2}{\hookleftarrow}}}
\xrightharpoonup[2][]{\underset{#1}{\overset{#2}{\rightharpoonup}}}
\xrightleftharpoons[2][]{\underset{#1}{\overset{#2}{\rightleftharpoons}}}
\coloneqq{\coloneq}
\eqqcolon{\eqcolon}
\Coloneqq{\Coloneq}
\vcentcolon{:}
\dblcolon{\Colon}
\DeclarePairedDelimiterX#1[#2]#3#4#5{\@define#1[#2]{\left#3#5\right#4}}
\mspace[1]{\hspace{#1}}
\nobreakdash{}

% ---------------------------------------------------------------------------
% graphicx, adjustbox and pdfpages: a picture's own keys are read by
% \includegraphics; what only a driver needs is let go.

\DeclareGraphicsExtensions[1]{}
\DeclareGraphicsRule[4]{}
\adjustbox[2]{#2}
\adjincludegraphics[2][]{\includegraphics[#1]{#2}}
\adjustimage[2]{\includegraphics{#2}}
\clipbox[2]{#2}
\trimbox[2]{#2}
\marginbox[2]{#2}
\lapbox[2][]{#2}
\maxsizebox[3]{#3}
\epsfbox[1]{\includegraphics{#1}}
\includepdf[2][]{\clearpage\noindent\includegraphics[page=1,width=\textwidth]{#2}\clearpage}
\includepdfmerge[2][]{\warning{includepdfmerge #2: pages of a PDF are not set here, and are left out}}
\includepdfset[1]{}

% ---------------------------------------------------------------------------
% The page and its paragraphs: running heads' styles and the spacing
